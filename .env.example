# Copiar a .env. En dev, stage y prod el pipeline escribe este archivo desde los GitHub Environments.
# Valores aleatorios: openssl rand -hex 24 (solo hexadecimal, sin $ ni comillas).

# Entorno: dev | stage | prod. Nombra el proyecto compose y la red puentes-<APP_ENV>. No lo usa compose.local.yaml.
APP_ENV=dev
# Imagen publicada en Docker Hub (solo dev, stage y prod)
DOCKERHUB_USERNAME=
IMAGE_TAG=

# PostgreSQL (DT-BD-13): puentes_migrador ejecuta las migraciones, puentes_app solo hace DML
DB_MIGRATION_PASSWORD=
DB_APP_PASSWORD=

# Credenciales de administración de MinIO (usuario >= 3 caracteres, contraseña >= 8)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Firma de los JWT: openssl rand -hex 32
JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma (DT-SEC-06)
CORS_ALLOWED_ORIGINS=http://localhost:4200
